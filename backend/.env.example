# Copy to backend/.env

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# New-style secret key (preferred) or legacy service_role JWT
SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # legacy alternative

# Shared with web/.env.local PROCESSOR_SECRET
PROCESSOR_SECRET=change-me-in-production

# Optional OCR for scanned / image-only PDF pages
# # OCR_SERVER_URL=  # deprecated — use DocStrange
# OCR_SERVER_URL=https://ocr.example/ocr
# # OCR_SERVER_SECRET=  # deprecated
# OCR_SERVER_SECRET=optional-bearer


# Nanonets DocStrange OCR (scanned PDFs / images)
# Get a key: https://docstrange.nanonets.com
DOCSTRANGE_API_KEY=
# Alias accepted by the same client:
# NANONETS_API_KEY=
