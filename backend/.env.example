# Copy to backend/.env

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Must be the service_role key (not the anon key) so the processor can
# download from the private documents bucket and write content_blocks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared with web/.env.local PROCESSOR_SECRET
PROCESSOR_SECRET=change-me-in-production

# Optional OCR for scanned / image-only PDF pages
# OCR_SERVER_URL=https://ocr.example/ocr
# OCR_SERVER_SECRET=optional-bearer
