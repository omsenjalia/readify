# Copy to web/.env.local and fill in values from your Supabase project
# (Settings → API) and your backend host.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used by the Next.js server to call the Python backend (folder: backend/).
# Required for PDF / DOCX / YouTube. Plain text uploads work without these.
PROCESSOR_URL=http://localhost:8001
PROCESSOR_SECRET=change-me-in-production
