# Copy to web/.env.local

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# New publishable key (preferred) or legacy anon JWT
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # legacy alternative (also still works)

# Required for PDF / DOCX / YouTube. Plain text works without these.
PROCESSOR_URL=http://localhost:8001
PROCESSOR_SECRET=change-me-in-production
