# Copy to web/.env.local and fill in values from your Supabase project
# (Settings → API) and your processor host.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only by the Next.js server to wake the Python processor.
PROCESSOR_URL=http://localhost:8001
PROCESSOR_SECRET=change-me-in-production
